# Copy to .env.local for dev, and set the same in Vercel project settings.
# NONE of these are ever exposed to the browser.

# OpenRouter API key for the AI assistant (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Which model the assistant uses (swappable). Recommended default:
#   deepseek/deepseek-v4-flash-0731  (cheap + strong)
# Alternatives: deepseek/deepseek-v4-pro | meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Random string used to sign session cookies (any long random value).
SESSION_SECRET=

# Salt used to hash member PINs. MUST match the salt used when PINs were
# generated (scripts/setup-pins.mjs writes the value it used here).
PIN_SALT=

# Google sign-in (optional; PIN login works without it). Create an OAuth 2.0
# Client (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-domain>/api/auth/google/callback
# Then fill each member's Gmail in data/fundData.json (the "email" field).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
